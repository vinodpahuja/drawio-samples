        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;sequenceDiagram\n  autonumber\n  participant C as Customer\n  participant FE as Storefront\n  participant GW as API Gateway\n  participant Cart as Cart Service\n  participant Inv as Inventory Service\n  participant Promo as Promotions Service\n  participant Pay as Payment Gateway\n  participant Order as Order Service\n  participant Ship as Shipping Service\n  participant Notif as Notification Service\n\n  C-&gt;&gt;FE: Browse products and add to cart\n  FE-&gt;&gt;GW: POST /cart/items\n  GW-&gt;&gt;Cart: Add item\n  Cart-&gt;&gt;Inv: Check stock availability\n  Inv--&gt;&gt;Cart: In stock\n  Cart--&gt;&gt;FE: Cart updated\n  C-&gt;&gt;FE: Checkout\n  FE-&gt;&gt;GW: POST /checkout\n  GW-&gt;&gt;Promo: Validate coupon and compute discounts\n  Promo--&gt;&gt;GW: Final price\n  GW-&gt;&gt;Inv: Reserve stock\n  alt Stock reserved\n    Inv--&gt;&gt;GW: Reservation confirmed\n    GW-&gt;&gt;Pay: Authorize payment\n    alt Payment authorized\n      Pay--&gt;&gt;GW: Authorization approved\n      GW-&gt;&gt;Order: Create order\n      Order--&gt;&gt;GW: Order ID\n      GW-&gt;&gt;Pay: Capture payment\n      Pay--&gt;&gt;GW: Payment captured\n      GW-&gt;&gt;Ship: Create shipment\n      Ship--&gt;&gt;GW: Tracking number\n      GW-&gt;&gt;Notif: Send confirmation email\n      Notif--&gt;&gt;C: Order confirmation\n      GW--&gt;&gt;FE: Order placed\n      FE--&gt;&gt;C: Show receipt and tracking\n    else Payment declined\n      Pay--&gt;&gt;GW: Declined\n      GW-&gt;&gt;Inv: Release reservation\n      GW--&gt;&gt;FE: Payment failed\n      FE--&gt;&gt;C: Prompt for another payment method\n    end\n  else Out of stock\n    Inv--&gt;&gt;GW: Insufficient stock\n    GW--&gt;&gt;FE: Item unavailable\n    FE--&gt;&gt;C: Show out-of-stock message\n  end&quot;,&#xa;  &quot;config&quot;: null,&#xa;  &quot;version&quot;: &quot;12&quot;&#xa;}" id="82">
